{
	"name": "pi-status-tab",
	"version": "0.1.3",
	"description": "Display pi's running state in the terminal tab title (iTerm2, Zed, etc.) and status bar, with subagent awareness.",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"README.md",
		"README.zh.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf node_modules",
		"check": "tsc --noEmit",
		"test": "tsx test/smoke.test.ts && tsx test/integration.test.ts",
		"test:unit": "tsx test/smoke.test.ts",
		"test:integration": "tsx test/integration.test.ts",
		"prepublishOnly": "npm run check && npm test"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"iterm2",
		"zed",
		"terminal",
		"tab-title",
		"subagent",
		"status"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "^1.3.7"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsx": "^4.23.5",
		"typescript": "^5.6.3"
	}
}
